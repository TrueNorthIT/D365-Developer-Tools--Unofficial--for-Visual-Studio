<UserControl x:Class="D365_Developer_Tools__Unofficial__for_Visual_Studio.Shared.Controls.FilterableComboBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vsp="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             x:ClassModifier="internal"
             x:Name="Root">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="18" />
        </Grid.ColumnDefinitions>

        <TextBox x:Name="PART_TextBox" Grid.Column="0" Padding="3"
                 TextChanged="OnTextBoxTextChanged" PreviewKeyDown="OnTextBoxPreviewKeyDown" />

        <Border x:Name="PART_ToggleButton" Grid.Column="1" Margin="2,0,0,0" Cursor="Hand"
                Background="{DynamicResource {x:Static vsp:CommonControlsColors.ButtonBrushKey}}"
                BorderBrush="{DynamicResource {x:Static vsp:CommonControlsColors.ButtonBorderBrushKey}}"
                BorderThickness="1"
                MouseLeftButtonUp="OnToggleButtonClick">
            <TextBlock Text="&#x25BE;" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource {x:Static vsp:CommonControlsColors.ButtonTextBrushKey}}" />
        </Border>

        <Popup x:Name="PART_Popup" PlacementTarget="{Binding ElementName=PART_TextBox}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True" Width="{Binding ActualWidth, ElementName=Root}"
               Closed="OnPopupClosed">
            <Border Background="{DynamicResource {x:Static vsp:CommonControlsColors.ComboBoxListBackgroundBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static vsp:CommonControlsColors.ComboBoxListBorderBrushKey}}"
                    BorderThickness="1">
                <ListBox x:Name="PART_ListBox" BorderThickness="0" Background="Transparent" MaxHeight="220"
                         PreviewMouseLeftButtonUp="OnListBoxPreviewMouseLeftButtonUp" />
            </Border>
        </Popup>
    </Grid>
</UserControl>
