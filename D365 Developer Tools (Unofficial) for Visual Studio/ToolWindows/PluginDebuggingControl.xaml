<UserControl x:Class="D365_Developer_Tools__Unofficial__for_Visual_Studio.ToolWindows.PluginDebuggingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:D365_Developer_Tools__Unofficial__for_Visual_Studio.Shared.Converters"
             xmlns:dlg="clr-namespace:D365_Developer_Tools__Unofficial__for_Visual_Studio.Shared.Dialogs"
             xmlns:vsp="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="420">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Shared/Styles/ThemedControls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVisibleConverter" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibleConverter" />
            <conv:EmptyToVisibleConverter x:Key="EmptyToVisibleConverter" />
            <dlg:EmptyToCollapsedConverter x:Key="EmptyToCollapsedConverter" />

            <!-- Ghost-text label overlaid on a filter TextBox in place of a separate label row — saves
                 the vertical space a real <TextBlock> above each box would cost. Pair with a same-named
                 bound property via EmptyToVisibleConverter so it disappears the moment there's real text.
                 Foreground is a plain hardcoded gray, deliberately not a DynamicResource theme brush — a
                 themed brush (first the root Grid's inherited TextElement.Foreground, tuned for the dark
                 tool-window background, then CommonControlsColors.TextBoxTextBrushKey) rendered invisible
                 against the actual TextBox background both times it was tried, confirmed via a loud
                 yellow/black diagnostic swap that the overlay mechanism itself was never the problem —
                 only the color choice was. VS's text input fields stay light-backgrounded across every
                 theme, so a plain gray reads reliably without needing to track that down further. -->
            <Style x:Key="FilterPlaceholderStyle" TargetType="TextBlock">
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="6,0,0,0" />
                <Setter Property="Foreground" Value="Gray" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource {x:Static vsp:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
          TextElement.Foreground="{DynamicResource {x:Static vsp:EnvironmentColors.ToolWindowTextBrushKey}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: connection status -->
        <Grid Grid.Row="0" Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1" Content="…" Width="24" Command="{Binding ShowMenuCommand}" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibleConverter}}" />
        </Grid>

        <!-- Trace-logging-level control: a manual dropdown covering all three real Dataverse settings,
             applying to the whole tool window (both tabs), not just one — Start/Stop Profiling never
             touches this itself, see PluginDebuggingViewModel.SelectedTracingLevel's doc comment. Only
             Off gets a warning (Exception is a legitimate, deliberate choice — capturing only executions
             that throw — not something to flag), and it's informational only: it never blocks arming a
             profiling session. -->
        <Grid Grid.Row="1" Margin="6,0,6,6" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibleConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Trace logging:" VerticalAlignment="Center" Margin="0,0,4,0" />
            <ComboBox Grid.Column="1" Width="90" ItemsSource="{Binding TracingLevelOptions}" SelectedItem="{Binding SelectedTracingLevel}" />
            <TextBlock Grid.Column="2" Margin="6,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="11"
                       Foreground="{DynamicResource {x:Static vsp:EnvironmentColors.ToolWindowValidationErrorTextBrushKey}}"
                       Text="Off — nothing will be captured until this changes"
                       Visibility="{Binding IsTracingOff, Converter={StaticResource BoolToVisibleConverter}}" />
        </Grid>

        <Grid Grid.Row="2">
            <StackPanel Visibility="{Binding IsRestoring, Converter={StaticResource BoolToVisibleConverter}}" Margin="12" HorizontalAlignment="Center">
                <TextBlock Text="Connecting…" HorizontalAlignment="Center" />
            </StackPanel>

            <StackPanel Margin="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsConnected}" Value="False" />
                                    <Condition Binding="{Binding IsRestoring}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="Connect to a D365 environment to view plugin trace logs." TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,8" />
                <Button Content="Connect" Command="{Binding ConnectCommand}" HorizontalAlignment="Center" Padding="12,4" />
            </StackPanel>

            <!-- Two tabs over the same plugintracelog table: "Trace Logs" (the plain, unscoped viewer)
                 and "Profile Captures" (scoped to one Start/Stop Profiling session + narrowed to rows
                 with a captured profile — where "Debug This" actually lives). -->
            <TabControl Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibleConverter}}" SelectedIndex="{Binding SelectedTabIndex}">
                <TabItem Header="Trace Logs">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Toolbar: structured filters (round-trip to Dataverse) + free-text search (client-side only) -->
                        <StackPanel Grid.Row="0" Margin="6">

                            <!-- Step filter chip, only present when opened via Plugin Explorer's "View Trace Logs..." -->
                            <Grid Margin="0,0,0,4" Visibility="{Binding HasStepFilter, Converter={StaticResource BoolToVisibleConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#332D7DD2" CornerRadius="2" Padding="4,2" TextElement.Foreground="White">
                                    <TextBlock FontSize="11" Text="{Binding StepFilterLabel, StringFormat='Step: {0}'}" TextTrimming="CharacterEllipsis" />
                                </Border>
                                <Button Grid.Column="1" Content="✕" Width="24" Margin="4,0,0,0" Command="{Binding ClearStepFilterCommand}" ToolTip="Clear step filter" />
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Margin="0,0,2,0">
                                    <!-- UpdateSourceTrigger=PropertyChanged (not TextBox.Text's LostFocus default) —
                                         otherwise clearing the box back to empty without tabbing away leaves EntityFilter
                                         holding its last-committed non-empty value, so the placeholder below stays
                                         Collapsed even though the box now reads empty. Matches SearchText's own binding. -->
                                    <TextBox Text="{Binding EntityFilter, UpdateSourceTrigger=PropertyChanged}" Padding="3" ToolTip="Filter by entity (primary entity logical name)…" />
                                    <TextBlock Text="Entity" Style="{StaticResource FilterPlaceholderStyle}"
                                               Visibility="{Binding EntityFilter, Converter={StaticResource EmptyToVisibleConverter}}" />
                                </Grid>
                                <Grid Grid.Column="1" Margin="2,0,0,0">
                                    <TextBox Text="{Binding MessageFilter, UpdateSourceTrigger=PropertyChanged}" Padding="3" ToolTip="Filter by message (e.g. Create, Update)…" />
                                    <TextBlock Text="Message" Style="{StaticResource FilterPlaceholderStyle}"
                                               Visibility="{Binding MessageFilter, Converter={StaticResource EmptyToVisibleConverter}}" />
                                </Grid>
                            </Grid>

                            <!-- Date + time of day — the underlying From/To values are full DateTimes (not just
                                 calendar dates), so the time box surfaces precision the DatePicker alone would
                                 silently discard from view (defaults to start/end of day if left blank). -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <DatePicker Grid.Column="0" Margin="0,0,2,0" SelectedDate="{Binding FromDate}" ToolTip="From date" />
                                <Grid Grid.Column="1" Margin="2,0,2,0">
                                    <TextBox Padding="3" Text="{Binding FromTimeText, UpdateSourceTrigger=PropertyChanged}" ToolTip="From time (HH:mm:ss) — defaults to start of day if blank" />
                                    <TextBlock Text="HH:mm:ss" Style="{StaticResource FilterPlaceholderStyle}"
                                               Visibility="{Binding FromTimeText, Converter={StaticResource EmptyToVisibleConverter}}" />
                                </Grid>
                                <DatePicker Grid.Column="2" Margin="2,0,2,0" SelectedDate="{Binding ToDate}" ToolTip="To date" />
                                <Grid Grid.Column="3" Margin="2,0,0,0">
                                    <TextBox Padding="3" Text="{Binding ToTimeText, UpdateSourceTrigger=PropertyChanged}" ToolTip="To time (HH:mm:ss) — defaults to end of day if blank" />
                                    <TextBlock Text="HH:mm:ss" Style="{StaticResource FilterPlaceholderStyle}"
                                               Visibility="{Binding ToTimeText, Converter={StaticResource EmptyToVisibleConverter}}" />
                                </Grid>
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Content="Exceptions only" VerticalAlignment="Center" IsChecked="{Binding ExceptionsOnly}" />
                                <CheckBox Grid.Column="1" Content="Auto-refresh" Margin="0,0,8,0" VerticalAlignment="Center" IsChecked="{Binding IsAutoRefreshEnabled}" />
                                <Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshCommand}" Padding="8,3" />
                            </Grid>

                            <Grid>
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="3" ToolTip="Search loaded results (type/trace text/exception)…" />
                                <TextBlock Text="Search…" Style="{StaticResource FilterPlaceholderStyle}"
                                           Visibility="{Binding SearchText, Converter={StaticResource EmptyToVisibleConverter}}" />
                            </Grid>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="2*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="1*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <!-- A TextBox (not TextBlock) so the error text — e.g. a raw Dataverse API error
                                     response — can actually be selected and copied. -->
                                <TextBox Margin="8,4" TextWrapping="Wrap" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                         Foreground="{DynamicResource {x:Static vsp:EnvironmentColors.ToolWindowValidationErrorTextBrushKey}}"
                                         Text="{Binding LoadError, Mode=OneWay}" Visibility="{Binding LoadError, Converter={StaticResource EmptyToCollapsedConverter}}" />
                                <TextBlock Margin="8,4" Text="Loading plugin trace logs…"
                                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibleConverter}}" />

                                <!-- Diagnostic aid while the plugintracelog schema's exact field shapes are still
                                     being verified against live environments — shows exactly what was queried and
                                     how many rows came back, without needing a debugger or VS's /log switch. -->
                                <TextBox Margin="8,0,8,4" FontSize="10" Opacity="0.7" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                         TextWrapping="Wrap" Text="{Binding LastQueryDescription, Mode=OneWay}"
                                         Visibility="{Binding LastQueryDescription, Converter={StaticResource EmptyToCollapsedConverter}}" />
                            </StackPanel>

                            <DataGrid Grid.Row="1" ItemsSource="{Binding EntriesView}" SelectedItem="{Binding SelectedEntry, Mode=TwoWay}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding CreatedOn, StringFormat='HH:mm:ss.fff'}" Width="90" />
                                    <DataGridTextColumn Header="Type" Binding="{Binding TypeName}" Width="2*" />
                                    <DataGridTextColumn Header="Message" Binding="{Binding MessageName}" Width="*" />
                                    <DataGridTextColumn Header="Entity" Binding="{Binding PrimaryEntity}" Width="*" />
                                    <DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="*" />
                                    <DataGridTextColumn Header="Duration (ms)" Binding="{Binding PerformanceExecutionDuration}" Width="90" />
                                    <DataGridTemplateColumn Header="Exception" Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="⚠" ToolTip="This execution threw an exception"
                                                           Foreground="{DynamicResource {x:Static vsp:EnvironmentColors.ToolWindowValidationErrorTextBrushKey}}"
                                                           Visibility="{Binding HasException, Converter={StaticResource BoolToVisibleConverter}}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" ResizeDirection="Rows" />

                            <Grid Grid.Row="3" Margin="0,4,0,0" Visibility="{Binding SelectedEntry, Converter={StaticResource NullToVisibleConverter}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Margin="8,0,8,2" FontWeight="Bold" Text="Trace" />
                                <!-- Plain monospace, no XML/JSON pretty-printing — ITracingService.Trace text isn't guaranteed structured. -->
                                <TextBox Grid.Row="1" Margin="8,0" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         FontFamily="Consolas" Text="{Binding SelectedEntry.MessageBlock, Mode=OneWay}" />

                                <TextBlock Grid.Row="2" Margin="8,4,8,2" FontWeight="Bold" Text="Exception"
                                           Visibility="{Binding SelectedEntry.HasException, Converter={StaticResource BoolToVisibleConverter}}" />
                                <TextBox Grid.Row="3" Margin="8,0,8,4" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         FontFamily="Consolas" Text="{Binding SelectedEntry.ExceptionDetails, Mode=OneWay}"
                                         Visibility="{Binding SelectedEntry.HasException, Converter={StaticResource BoolToVisibleConverter}}" />
                            </Grid>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="Profile Captures">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="2*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="6">
                            <!-- Active-profiling-session chip — only present once "Start Profiling..." has armed a step from Plugin Explorer. -->
                            <Grid Margin="0,0,0,4" Visibility="{Binding HasActiveProfilingSession, Converter={StaticResource BoolToVisibleConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#332D7DD2" CornerRadius="2" Padding="4,2" TextElement.Foreground="White">
                                    <TextBlock FontSize="11" Text="{Binding ActiveProfilingSessionLabel, StringFormat='Profiling: {0}'}" TextTrimming="CharacterEllipsis" />
                                </Border>
                                <Button Grid.Column="1" Content="Stop Profiling" Margin="4,0,0,0" Padding="6,3" Command="{Binding StopProfilingSessionCommand}" />
                            </Grid>

                            <!-- Adjustable timeframe — defaults to when profiling was armed (see
                                 PluginDebuggingViewModel.LoadForProfiledStepAsync) but is not a hard floor:
                                 widen it to see captures from before this session, or narrow it, freely. -->
                            <!-- Date + time of day — ProfileFromDate defaults to the exact moment profiling was
                                 armed (down to the second), which the time box surfaces; the DatePicker alone
                                 would silently hide that precision from view. -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <DatePicker Grid.Column="0" Margin="0,0,2,0" SelectedDate="{Binding ProfileFromDate}" ToolTip="From date (defaults to when profiling started)" />
                                <Grid Grid.Column="1" Margin="2,0,2,0">
                                    <TextBox Padding="3" Text="{Binding ProfileFromTimeText, UpdateSourceTrigger=PropertyChanged}" ToolTip="From time (HH:mm:ss) — defaults to start of day if blank" />
                                    <TextBlock Text="HH:mm:ss" Style="{StaticResource FilterPlaceholderStyle}"
                                               Visibility="{Binding ProfileFromTimeText, Converter={StaticResource EmptyToVisibleConverter}}" />
                                </Grid>
                                <DatePicker Grid.Column="2" Margin="2,0,2,0" SelectedDate="{Binding ProfileToDate}" ToolTip="To date (blank = no upper bound)" />
                                <Grid Grid.Column="3" Margin="2,0,0,0">
                                    <TextBox Padding="3" Text="{Binding ProfileToTimeText, UpdateSourceTrigger=PropertyChanged}" ToolTip="To time (HH:mm:ss) — defaults to end of day if blank" />
                                    <TextBlock Text="HH:mm:ss" Style="{StaticResource FilterPlaceholderStyle}"
                                               Visibility="{Binding ProfileToTimeText, Converter={StaticResource EmptyToVisibleConverter}}" />
                                </Grid>
                            </Grid>

                            <Button Content="Refresh" HorizontalAlignment="Right" Padding="8,3" Command="{Binding RefreshProfileCapturesCommand}"
                                    ToolTip="Manual only — profile captures are deliberate and bounded, not a high-volume stream like trace logs." />

                            <!-- Diagnostic aid, mirroring the Trace Logs tab's own LastQueryDescription — shows
                                 exactly what was queried (TypeName/From/HasCapturedProfile) and how many rows
                                 came back, so an unexpectedly-empty result can be checked without a debugger. -->
                            <TextBox Margin="0,4,0,0" FontSize="10" Opacity="0.7" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                     TextWrapping="Wrap" Text="{Binding LastProfileQueryDescription, Mode=OneWay}"
                                     Visibility="{Binding LastProfileQueryDescription, Converter={StaticResource EmptyToCollapsedConverter}}" />
                        </StackPanel>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding ProfileEntries}" SelectedItem="{Binding SelectedProfileEntry, Mode=TwoWay}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding CreatedOn, StringFormat='HH:mm:ss.fff'}" Width="90" />
                                <DataGridTextColumn Header="Message" Binding="{Binding MessageName}" Width="*" />
                                <DataGridTextColumn Header="Entity" Binding="{Binding PrimaryEntity}" Width="*" />
                                <DataGridTextColumn Header="Duration (ms)" Binding="{Binding PerformanceExecutionDuration}" Width="90" />
                                <DataGridTextColumn Header="Correlation" Binding="{Binding CorrelationId}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" ResizeDirection="Rows" />

                        <Grid Grid.Row="3" Margin="0,4,0,0" Visibility="{Binding SelectedProfileEntry, Converter={StaticResource NullToVisibleConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="8,0,8,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding SelectedProfileEntry.Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Debug This" Padding="8,3" Command="{Binding DebugCommand}"
                                        ToolTip="Replay this captured execution locally with real breakpoints." />
                            </Grid>

                            <!-- Non-modal debug session status strip — set for the lifetime of one "Debug This" run. -->
                            <Border Grid.Row="1" Margin="8,0,8,4" Padding="6,4" Background="#332D7DD2" CornerRadius="2" TextElement.Foreground="White"
                                    Visibility="{Binding DebugSession, Converter={StaticResource NullToVisibleConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock FontSize="11" FontWeight="Bold" Text="{Binding DebugSession.Label}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="11" Text="{Binding DebugSession.StatusText}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Stop" Padding="8,3" VerticalAlignment="Center" Command="{Binding StopDebugSessionCommand}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
