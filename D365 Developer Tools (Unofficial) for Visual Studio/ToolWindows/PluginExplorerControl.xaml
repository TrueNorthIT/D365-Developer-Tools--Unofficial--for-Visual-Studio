<UserControl x:Class="D365_Developer_Tools__Unofficial__for_Visual_Studio.ToolWindows.PluginExplorerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:D365_Developer_Tools__Unofficial__for_Visual_Studio.Shared.Converters"
             xmlns:dlg="clr-namespace:D365_Developer_Tools__Unofficial__for_Visual_Studio.Shared.Dialogs"
             xmlns:vsp="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:img="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:catalog="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.ImageCatalog"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="320">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Shared/Styles/ThemedControls.xaml" />
            </ResourceDictionary.MergedDictionaries>

        <conv:BoolToVisibilityConverter x:Key="BoolToVisibleConverter" />
        <conv:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />
        <conv:BoolToAssemblyIconConverter x:Key="BoolToAssemblyIconConverter" />
        <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
        <dlg:EmptyToCollapsedConverter x:Key="EmptyToCollapsedConverter" />

        <ContextMenu x:Key="AssemblyContextMenu">
            <MenuItem Header="Edit Description..." Click="OnEditAssemblyDescriptionClick" />
            <MenuItem Header="Unregister..." Click="OnUnregisterAssemblyClick" />
        </ContextMenu>
        <ContextMenu x:Key="TypeContextMenu">
            <MenuItem Header="Add Step..." Click="OnAddStepClick" />
            <MenuItem Header="Unregister..." Click="OnUnregisterTypeClick" />
        </ContextMenu>
        <ContextMenu x:Key="StepContextMenu">
            <MenuItem Header="Edit Step..." Click="OnEditStepClick" />
            <MenuItem Header="Enable" Click="OnEnableStepClick" IsEnabled="{Binding IsEnabled, Converter={StaticResource InverseBoolConverter}}" />
            <MenuItem Header="Disable" Click="OnDisableStepClick" IsEnabled="{Binding IsEnabled}" />
            <MenuItem Header="Add Image..." Click="OnAddImageClick" />
            <MenuItem Header="Unregister..." Click="OnUnregisterStepClick" />
        </ContextMenu>
        <ContextMenu x:Key="ImageContextMenu">
            <MenuItem Header="Edit Image..." Click="OnEditImageClick" />
            <MenuItem Header="Unregister..." Click="OnUnregisterImageClick" />
        </ContextMenu>
        <ContextMenu x:Key="CustomApiContextMenu">
            <MenuItem Header="Edit Custom API..." Click="OnEditCustomApiClick" />
            <MenuItem Header="Add Request Parameter..." Click="OnAddCustomApiRequestParameterClick" />
            <MenuItem Header="Add Response Property..." Click="OnAddCustomApiResponsePropertyClick" />
            <MenuItem Header="Unregister..." Click="OnUnregisterCustomApiClick" />
        </ContextMenu>
        <ContextMenu x:Key="CustomApiParameterContextMenu">
            <MenuItem Header="Edit..." Click="OnEditCustomApiParameterClick" />
            <MenuItem Header="Unregister..." Click="OnUnregisterCustomApiParameterClick" />
        </ContextMenu>

        <DataTemplate x:Key="ImageTemplate">
            <Grid Margin="0,1" ContextMenu="{StaticResource ImageContextMenu}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <img:CrispImage Grid.Column="0" Width="16" Height="16" Margin="0,0,4,0" VerticalAlignment="Center" Moniker="{x:Static catalog:KnownMonikers.ImageIcon}" />
                <Border Grid.Column="1" Background="#332D7DD2" CornerRadius="2" Padding="3,0" Margin="0,0,4,0">
                    <TextBlock FontSize="10" Text="{Binding ImageType}" />
                </Border>
                <TextBlock Grid.Column="2" Text="{Binding EntityAlias}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="3" Margin="6,0,0,0" Opacity="0.6" FontSize="10" Text="{Binding Name}" />
            </Grid>
        </DataTemplate>

        <HierarchicalDataTemplate x:Key="StepTemplate" ItemsSource="{Binding Images}" ItemTemplate="{StaticResource ImageTemplate}">
            <Grid Margin="0,1" Opacity="{Binding IsEnabled, Converter={StaticResource BoolToOpacityConverter}}" ContextMenu="{StaticResource StepContextMenu}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <img:CrispImage Grid.Column="0" Width="16" Height="16" Margin="0,0,4,0" VerticalAlignment="Center" Moniker="{x:Static catalog:KnownMonikers.Event}" />
                <TextBlock Grid.Column="1" Text="{Binding Summary}" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding FilteringAttributes}" />
                <TextBlock Grid.Column="2" Margin="6,0,0,0" Opacity="0.6" FontSize="10" Text="{Binding Mode}" />
            </Grid>
        </HierarchicalDataTemplate>

        <HierarchicalDataTemplate x:Key="TypeTemplate" ItemsSource="{Binding Steps}" ItemTemplate="{StaticResource StepTemplate}">
            <Grid Margin="0,2" ContextMenu="{StaticResource TypeContextMenu}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <img:CrispImage Grid.Column="0" Width="16" Height="16" Margin="0,0,4,0" VerticalAlignment="Center" Moniker="{x:Static catalog:KnownMonikers.ClassPublic}" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                <TextBlock Grid.Column="2" Margin="6,0,0,0" Opacity="0.6" FontSize="11" Text="Workflow Activity"
                           Visibility="{Binding IsWorkflowActivity, Converter={StaticResource BoolToVisibleConverter}}" />
            </Grid>
        </HierarchicalDataTemplate>

        <HierarchicalDataTemplate x:Key="AssemblyTemplate" ItemsSource="{Binding Types}" ItemTemplate="{StaticResource TypeTemplate}">
            <Grid Margin="0,2" ContextMenu="{StaticResource AssemblyContextMenu}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <img:CrispImage Grid.Column="0" Width="16" Height="16" Margin="0,0,4,0" VerticalAlignment="Center"
                                Moniker="{Binding HasPackage, Converter={StaticResource BoolToAssemblyIconConverter}}" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Margin="6,0,0,0" Opacity="0.6" FontSize="11" Text="{Binding PackageName}"
                               Visibility="{Binding HasPackage, Converter={StaticResource BoolToVisibleConverter}}" />
                    <TextBlock Margin="6,0,0,0" Opacity="0.6" FontSize="11" Text="{Binding Version}" />
                    <TextBlock Margin="6,0,0,0" Opacity="0.6" FontSize="11" Text="{Binding IsolationMode}" />
                </StackPanel>
            </Grid>
        </HierarchicalDataTemplate>

        <DataTemplate x:Key="CustomApiParameterTemplate">
            <Grid Margin="0,1" ContextMenu="{StaticResource CustomApiParameterContextMenu}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#332D7DD2" CornerRadius="2" Padding="3,0" Margin="0,0,4,0">
                    <TextBlock FontSize="10" Text="{Binding Kind}" />
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Margin="6,0" Opacity="0.6" FontSize="10" Text="(optional)"
                           Visibility="{Binding IsOptional, Converter={StaticResource BoolToVisibleConverter}}" />
                <TextBlock Grid.Column="3" Margin="6,0,0,0" Opacity="0.6" FontSize="10" Text="{Binding Type}" />
            </Grid>
        </DataTemplate>

        <HierarchicalDataTemplate x:Key="CustomApiTemplate" ItemsSource="{Binding Parameters}" ItemTemplate="{StaticResource CustomApiParameterTemplate}">
            <Grid Margin="0,2" ContextMenu="{StaticResource CustomApiContextMenu}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <img:CrispImage Grid.Column="0" Width="16" Height="16" Margin="0,0,4,0" VerticalAlignment="Center" Moniker="{x:Static catalog:KnownMonikers.WebService}" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis" ToolTip="{Binding UniqueName}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Margin="6,0,0,0" Opacity="0.6" FontSize="11" Text="{Binding BindingType}" />
                    <TextBlock Margin="6,0,0,0" Opacity="0.6" FontSize="11" Text="Function"
                               Visibility="{Binding IsFunction, Converter={StaticResource BoolToVisibleConverter}}" />
                </StackPanel>
            </Grid>
        </HierarchicalDataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource {x:Static vsp:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
          TextElement.Foreground="{DynamicResource {x:Static vsp:EnvironmentColors.ToolWindowTextBrushKey}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: connection status -->
        <Grid Grid.Row="0" Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1" Content="…" Width="24" Command="{Binding ShowMenuCommand}" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibleConverter}}" />
        </Grid>

        <!-- Toolbar: search + solution filter (only when connected) -->
        <StackPanel Grid.Row="1" Margin="6,0,6,6" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibleConverter}}">
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="3" ToolTip="Search assemblies…" />
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Command="{Binding ShowSolutionPickerCommand}"
                        Content="{Binding SolutionFilterName, TargetNullValue='All solutions'}" HorizontalContentAlignment="Left" />
                <Button Grid.Column="1" Content="✕" Width="24" Margin="4,0,0,0"
                        Command="{Binding ClearSolutionFilterCommand}"
                        Visibility="{Binding HasSolutionFilter, Converter={StaticResource BoolToVisibleConverter}}" />
            </Grid>
            <Button Content="Publish project to Dataverse..." Command="{Binding PublishProjectCommand}" Margin="0,4,0,0" Padding="4,3" />
        </StackPanel>

        <!-- Body -->
        <Grid Grid.Row="2">
            <StackPanel Visibility="{Binding IsRestoring, Converter={StaticResource BoolToVisibleConverter}}" Margin="12" HorizontalAlignment="Center">
                <TextBlock Text="Connecting…" HorizontalAlignment="Center" />
            </StackPanel>

            <StackPanel Margin="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsConnected}" Value="False" />
                                    <Condition Binding="{Binding IsRestoring}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="Connect to a D365 environment to browse plugin assemblies." TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,8" />
                <Button Content="Connect" Command="{Binding ConnectCommand}" HorizontalAlignment="Center" Padding="12,4" />
            </StackPanel>

            <Grid Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibleConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Margin="8,4" TextWrapping="Wrap"
                           Foreground="{DynamicResource {x:Static vsp:EnvironmentColors.ToolWindowValidationErrorTextBrushKey}}"
                           Text="{Binding LoadError}" Visibility="{Binding LoadError, Converter={StaticResource EmptyToCollapsedConverter}}" />
                <TextBlock Grid.Row="0" Margin="8,4" Text="Loading plugin assemblies…"
                           Visibility="{Binding IsLoadingAssemblies, Converter={StaticResource BoolToVisibleConverter}}" />

                <TreeView x:Name="AssemblyTree" Grid.Row="1" ItemsSource="{Binding AssembliesView}" ItemTemplate="{StaticResource AssemblyTemplate}">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>

                <!-- Custom APIs: a separate top-level section, not owned by any one assembly. -->
                <Grid Grid.Row="2" Margin="0,8,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Margin="8,0" VerticalAlignment="Center" FontWeight="Bold" Text="Custom APIs" />
                    <Button Grid.Column="1" Content="Add Custom API..." Command="{Binding AddCustomApiCommand}" Padding="4,2" />
                </Grid>

                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Margin="8,4" TextWrapping="Wrap"
                               Foreground="{DynamicResource {x:Static vsp:EnvironmentColors.ToolWindowValidationErrorTextBrushKey}}"
                               Text="{Binding CustomApisLoadError}" Visibility="{Binding CustomApisLoadError, Converter={StaticResource EmptyToCollapsedConverter}}" />
                    <TextBlock Grid.Row="0" Margin="8,4" Text="Loading Custom APIs…"
                               Visibility="{Binding IsLoadingCustomApis, Converter={StaticResource BoolToVisibleConverter}}" />

                    <TreeView x:Name="CustomApiTree" Grid.Row="1" ItemsSource="{Binding CustomApis}" ItemTemplate="{StaticResource CustomApiTemplate}">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
