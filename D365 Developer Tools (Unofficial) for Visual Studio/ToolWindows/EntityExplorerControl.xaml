<UserControl x:Class="D365_Developer_Tools__Unofficial__for_Visual_Studio.ToolWindows.EntityExplorerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:D365_Developer_Tools__Unofficial__for_Visual_Studio.Shared.Converters"
             xmlns:dlg="clr-namespace:D365_Developer_Tools__Unofficial__for_Visual_Studio.Shared.Dialogs"
             xmlns:vsp="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="320">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Shared/Styles/ThemedControls.xaml" />
            </ResourceDictionary.MergedDictionaries>

        <conv:BoolToVisibilityConverter x:Key="BoolToVisibleConverter" />
        <conv:PrimaryMarkerConverter x:Key="PrimaryMarkerConverter" />
        <dlg:EmptyToCollapsedConverter x:Key="EmptyToCollapsedConverter" />

        <ContextMenu x:Key="EntityContextMenu">
            <MenuItem Header="Generate C# Class" Click="OnGenerateClassClick" />
        </ContextMenu>
        <ContextMenu x:Key="AttributeContextMenu">
            <MenuItem Header="Generate Enum" Click="OnGenerateEnumClick" IsEnabled="{Binding IsOptionSet}" />
        </ContextMenu>

        <HierarchicalDataTemplate x:Key="AttributeTemplate">
            <Grid ContextMenu="{StaticResource AttributeContextMenu}" Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Margin="0,0,4,0" Text="{Binding IsPrimaryId, Converter={StaticResource PrimaryMarkerConverter}}" />
                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Margin="6,0" Opacity="0.6" FontSize="10" Text="{Binding LogicalName}" />
                <Border Grid.Column="3" Background="#332D7DD2" CornerRadius="2" Padding="3,0">
                    <TextBlock FontSize="10" Text="{Binding AttributeType}" />
                </Border>
            </Grid>
        </HierarchicalDataTemplate>

        <HierarchicalDataTemplate x:Key="EntityTemplate" ItemsSource="{Binding Attributes}" ItemTemplate="{StaticResource AttributeTemplate}">
            <Grid ContextMenu="{StaticResource EntityContextMenu}" Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Margin="6,0,0,0" Opacity="0.6" FontSize="11" Text="{Binding LogicalName}" />
            </Grid>
        </HierarchicalDataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource {x:Static vsp:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
          TextElement.Foreground="{DynamicResource {x:Static vsp:EnvironmentColors.ToolWindowTextBrushKey}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: connection status -->
        <Grid Grid.Row="0" Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="1" Content="…" Width="24" Command="{Binding ShowMenuCommand}" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibleConverter}}" />
        </Grid>

        <!-- Toolbar: search + solution filter (only when connected) -->
        <StackPanel Grid.Row="1" Margin="6,0,6,6" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibleConverter}}">
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="3" ToolTip="Search entities…" />
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Command="{Binding ShowSolutionPickerCommand}"
                        Content="{Binding SolutionFilterName, TargetNullValue='All solutions'}" HorizontalContentAlignment="Left" />
                <Button Grid.Column="1" Content="✕" Width="24" Margin="4,0,0,0"
                        Command="{Binding ClearSolutionFilterCommand}"
                        Visibility="{Binding HasSolutionFilter, Converter={StaticResource BoolToVisibleConverter}}" />
            </Grid>
        </StackPanel>

        <!-- Body -->
        <Grid Grid.Row="2">
            <StackPanel Visibility="{Binding IsRestoring, Converter={StaticResource BoolToVisibleConverter}}" Margin="12" HorizontalAlignment="Center">
                <TextBlock Text="Connecting…" HorizontalAlignment="Center" />
            </StackPanel>

            <StackPanel Margin="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsConnected}" Value="False" />
                                    <Condition Binding="{Binding IsRestoring}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="Connect to a D365 environment to browse entities." TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,8" />
                <Button Content="Connect" Command="{Binding ConnectCommand}" HorizontalAlignment="Center" Padding="12,4" />
            </StackPanel>

            <Grid Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibleConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Margin="8,4" TextWrapping="Wrap"
                           Foreground="{DynamicResource {x:Static vsp:EnvironmentColors.ToolWindowValidationErrorTextBrushKey}}"
                           Text="{Binding LoadError}" Visibility="{Binding LoadError, Converter={StaticResource EmptyToCollapsedConverter}}" />
                <TextBlock Grid.Row="0" Margin="8,4" Text="Loading entities…"
                           Visibility="{Binding IsLoadingEntities, Converter={StaticResource BoolToVisibleConverter}}" />

                <TreeView x:Name="EntityTree" Grid.Row="1" ItemsSource="{Binding EntitiesView}" ItemTemplate="{StaticResource EntityTemplate}">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
